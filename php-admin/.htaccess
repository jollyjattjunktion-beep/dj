Options -Indexes
RewriteEngine On
RewriteRule ^health$ health.php [L]
RewriteRule ^api/songs/?$ api/songs.php [QSA,L]
RewriteRule ^song/[0-9]+-[a-zA-Z0-9-]+/?$ index.html [L]
RewriteRule ^songs/?$ index.html [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^song/([a-zA-Z0-9-]+)/?$ index.php?song=$1 [QSA,L]
RewriteRule ^songs/?$ index.php?all=1 [QSA,L]
