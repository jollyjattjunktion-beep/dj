# Authorized RSS/Atom or JSON feed endpoint. Must be HTTPS.
FEED_URL=
FEED_FORMAT=auto
FEED_USER_AGENT=JattBeatImporter/1.0 (+contact your domain administrator)

# Comma-separated hosts approved for the relevant use.
SOURCE_ALLOWED_HOSTS=
AUDIO_ALLOWED_HOSTS=
ARTWORK_ALLOWED_HOSTS=

# Keep private. Render can generate these values for a new deployment.
IMPORT_TOKEN=
MEDIA_TOKEN_SECRET=

# WordPress is the canonical song catalogue. Use a dedicated Editor user.
WP_BASE_URL=https://jattbeat.com
WP_USERNAME=
WP_APP_PASSWORD=
WP_POST_STATUS=draft

# Public URL of the Render API, used when generating absolute signed media URLs.
PUBLIC_API_BASE_URL=https://dj-laqb.onrender.com

# Render persistent disk path; local development can use ./catalog.sqlite3
DB_PATH=./catalog.sqlite3
