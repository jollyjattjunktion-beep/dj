# Authorized RSS/Atom or JSON feed endpoint. Must be HTTPS.
FEED_URL=
FEED_FORMAT=auto
FEED_USER_AGENT=PreetMusicPortal/0.1 (+contact your domain administrator)

# Comma-separated host allow-lists. Set only provider/source hosts you are authorized to use.
SOURCE_ALLOWED_HOSTS=
AUDIO_ALLOWED_HOSTS=

# Set a long random value. Keep private.
IMPORT_TOKEN=

# Optional WordPress sync. Install the supplied plugin first.
WP_BASE_URL=
WP_USERNAME=
WP_APP_PASSWORD=
WP_POST_STATUS=draft

# Render persistent disk path; local development can use ./catalog.sqlite3
DB_PATH=./catalog.sqlite3
